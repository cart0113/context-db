#!/usr/bin/env bash
#
# pre-commit — keep the index, the code, and the tests honest.
#
#   1. ruff format + fix on staged Python files (if ruff is installed)
#   2. context-db index --check on this repo's own bundle
#   3. pytest when the skill, the migration script, the example, or tests change
#
# Install:
#   cp hooks/pre-commit .git/hooks/pre-commit

set -eo pipefail
cd "$(git rev-parse --show-toplevel)"

PYTHON=python3
[ -x .venv/bin/python ] && PYTHON=.venv/bin/python
RUFF="$(command -v ruff || true)"
[ -x .venv/bin/ruff ] && RUFF=.venv/bin/ruff

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -n "$RUFF" ]; then
    echo "$STAGED" | grep -E '\.py$' | while IFS= read -r file; do
        [ -f "$file" ] || continue
        "$RUFF" format -q "$file"
        "$RUFF" check -q --fix "$file"
        git add "$file"
    done
fi

"$PYTHON" skill/context-db/context-db.py index --check || {
    echo "Run: python3 skill/context-db/context-db.py index"
    exit 1
}

if echo "$STAGED" | grep -qE '^(skill/|tests/|example/|context-db/context-db-project/context-db-migrate-from-v0.0/)'; then
    if "$PYTHON" -c "import pytest" 2>/dev/null; then
        "$PYTHON" -m pytest tests -q
    else
        echo "pytest is not installed; skipping tests."
    fi
fi
