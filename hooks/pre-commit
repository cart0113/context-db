#!/usr/bin/env bash
#
# pre-commit — keep the knowledge base, the code, and the tests honest.
#
#   1. ruff format + fix on staged Python files (if ruff is installed)
#   2. context-db toc --check on this repo's own knowledge base
#   3. pytest when the skill, the migration script, the example, or tests change
#
# Install:
#   cp hooks/pre-commit .git/hooks/pre-commit

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PYTHON=python3
if [ -x .venv/bin/python ]; then PYTHON=.venv/bin/python; fi
RUFF="$(command -v ruff || true)"
if [ -x .venv/bin/ruff ]; then RUFF=.venv/bin/ruff; fi

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -n "$RUFF" ]; then
    while IFS= read -r file; do
        case "$file" in
            *.py)
                [ -f "$file" ] || continue
                "$RUFF" format -q "$file"
                "$RUFF" check -q --fix "$file"
                git add "$file"
                ;;
        esac
    done <<< "$STAGED"
fi

if ! "$PYTHON" skill/context-db/context-db.py toc --check; then
    echo "pre-commit: fix what  python3 skill/context-db/context-db.py toc --check  reports."
    exit 1
fi

case "$STAGED" in
    *skill/* | *tests/* | *example/* | *context-db-migrate-from-v0.0/*)
        if "$PYTHON" -c "import pytest" 2>/dev/null; then
            "$PYTHON" -m pytest tests -q
        else
            echo "pre-commit: pytest is not installed; skipping tests."
        fi
        ;;
esac
